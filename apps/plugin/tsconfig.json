{
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["DOM", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "target": "ESNext",
    "types": ["@figma/plugin-typings", "vite/client"],
    "paths": {
      "@main/*": ["./src/main/*"],
      "@plugin-shared/*": ["./src/shared/*"],
      "@ui/*": ["./src/ui/*"]
    },
    "skipLibCheck": true
  },
  "include": ["src"]
}
